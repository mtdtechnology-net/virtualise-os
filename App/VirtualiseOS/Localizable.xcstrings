    "The virtual machine is already in use. Quit any other running copy of VirtualiseOS or wait for the previous VM process to finish, then start the app again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die virtuelle Maschine wird bereits verwendet. Beenden Sie alle anderen laufenden Kopien von VirtualiseOS oder warten Sie, bis der vorherige VM-Prozess beendet ist, und starten Sie die App dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine virtuelle est déjà utilisée. Quittez toute autre copie de VirtualiseOS en cours d’exécution ou attendez la fin du processus VM précédent, puis relancez l’app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A virtuális gép már használatban van. Zárja be a VirtualiseOS minden más futó példányát, vagy várja meg, amíg az előző VM-folyamat befejeződik, majd indítsa újra az alkalmazást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina virtuale è già in uso. Chiudi eventuali altre copie di VirtualiseOS in esecuzione oppure attendi il termine del processo VM precedente, quindi riavvia l’app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
